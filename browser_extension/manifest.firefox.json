{
  "manifest_version": 3,
  "name": "Cert Filter",
  "description": "Фильтрация сертификатов CryptoPro по JSON-конфигу",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "cert-filter@local",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Cert Filter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["nativeMessaging", "storage"]
}
